{
  "$schema": "../../schema/policy.schema.json",
  "version": 1,
  "owner": "platform-team@acme.io",
  "mode": "normal",
  "scope": {
    "allow": ["requirements*.txt", "package.json", "package-lock.json", ".github/workflows/*.yml"],
    "deny": ["**/*deploy*", "**/*release*", "infra/**", "**/*secret*"]
  },
  "clearance": {
    "auto": ["missing-python-module"],
    "hold": [
      "set-output-deprecated",
      "lockfile-drift",
      "node-missing-module",
      "npm-peer-conflict",
      "pip-resolution-conflict",
      "deprecated-action-version",
      "unknown"
    ],
    "refuse": [
      "missing-secret",
      "job-timeout",
      "runner-oom",
      "disk-full",
      "test-failure",
      "python-syntax-error"
    ]
  },
  "warrant": { "reuse": true, "expires_after_days": 14, "max_uses": 5 },
  "limits": { "max_files_changed": 2, "max_lines_changed": 20 },
  "record": { "path": ".interlock/ledger.jsonl" }
}
